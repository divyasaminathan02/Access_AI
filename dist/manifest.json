{
  "manifest_version": 3,
  "name": "AccessAI — Adaptive Reading & Accessibility",
  "version": "2.0.0",
  "description": "Accessibility that learns. Observes non-sensitive interaction patterns to evolve your Personal Reading Fingerprint over time.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AccessAI Quick Controls"
  },
  "background": {
    "service_worker": "src/background/serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
